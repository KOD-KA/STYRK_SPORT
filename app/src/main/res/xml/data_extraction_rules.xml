<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила для Android 12 и новее (API 31+). Здесь два разных случая,
    и относиться к ним стоит по-разному.

    cloud-backup — копия уезжает на серверы Google. Ключ доступа
    к учётной записи оттуда исключён: см. пояснение в backup_rules.xml.

    device-transfer — прямой перенос со старого телефона на новый,
    когда человек стоит с двумя устройствами в руках. Данные никуда
    не уходят, поэтому ключ переносится вместе со всем остальным:
    новый телефон сразу оказывается в том же аккаунте, и вводить
    пароль заново не нужно.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="styrk_sync.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>